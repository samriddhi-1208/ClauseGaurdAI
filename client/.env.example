# ClauseGuard AI - React Frontend Environment Configuration

# In local development, the Vite dev server proxies /api to http://localhost:5000.
# For decoupled production deployments (e.g. Vercel, Netlify, Cloudflare Pages),
# set VITE_API_URL to your backend API base URL.
VITE_API_URL=/api
# Example for production:
# VITE_API_URL=https://api.clauseguard.yourdomain.com/api
